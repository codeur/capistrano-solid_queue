[Unit]
Description=SolidQueue background job for <%= fetch(:application) %> (<%= fetch(:stage) %>)
After=syslog.target network.target

[Service]
Type=simple
<% if fetch(:solid_queue_systemctl_user) == :system -%>
User=<%= capture(:id, "-un") %>
<% end -%>
Environment='RAILS_ENV=<%= fetch(:rails_env, fetch(:stage)) %>'
<% fetch(:default_env).reject{ |k, _| k.to_s == 'path' }.each do |variable, value| -%>
Environment='<%= variable.to_s.upcase %>=<%= capture(:printf, "%s", %("#{value.to_s.gsub('"', '\"')}")) %>'
<% end -%>
WorkingDirectory=<%= current_path %>
ExecStart=<%= capture(:echo, SSHKit.config.command_map[:bundle]).strip %> exec bin/jobs
ExecStop=/bin/kill -TERM $MAINPID
Environment=MALLOC_ARENA_MAX=2
<% fetch(:solid_queue_service_unit_env_vars).each do |variable| -%>
Environment="<%= variable %>"
<% end -%>
<% fetch(:solid_queue_service_unit_env_files).each do |file| -%>
EnvironmentFile=<%= file %>
<% end -%>

# if we crash, restart
RestartSec=1
Restart=on-failure

<%= "StandardOutput=append:#{fetch(:solid_queue_access_log)}" if fetch(:solid_queue_access_log) %>
<%= "StandardError=append:#{fetch(:solid_queue_error_log)}" if fetch(:solid_queue_error_log) %>

SyslogIdentifier=<%= fetch(:solid_queue_service_unit_name) %>

[Install]
WantedBy=default.target
